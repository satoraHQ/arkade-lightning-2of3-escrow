# arkade-regtest overrides for the escrow e2e tests.
#
# Consumed by the regtest submodule's Node CLI:
#   node regtest/regtest.mjs start --env .env.regtest --profile ark
# The orchestrator also auto-discovers this file as `../.env.regtest`, so the
# subcommands the tests call (rotate-signer, arkd note, ark send) pick it up.

# arkd runs from these images. Keep in step with the ark-grpc/ark-core version
# in escrow/Cargo.toml (0.12.0 is tested against arkd 0.9.15 upstream).
ARKD_IMAGE=ghcr.io/arkade-os/arkd:v0.9.15
ARKD_WALLET_IMAGE=ghcr.io/arkade-os/arkd-wallet:v0.9.15

# Exit delays are multiples of 512 seconds (wall-clock scheduler).
ARKD_VTXO_MIN_AMOUNT=1
ARKD_UNILATERAL_EXIT_DELAY=512
ARKD_PUBLIC_UNILATERAL_EXIT_DELAY=512
ARKD_BOARDING_EXIT_DELAY=1024
ARKD_VTXO_TREE_EXPIRY=512
ARKD_CHECKPOINT_EXIT_DELAY=512

# Mine a block every 2s so refresh batches settle within the test's wait.
AUTOMINE_INTERVAL=2

# Zero intent fees: the tests assert exact escrow amounts after refresh.
ARK_OFFCHAIN_INPUT_FEE="0.0"
ARK_ONCHAIN_INPUT_FEE="0.0"
ARK_OFFCHAIN_OUTPUT_FEE="0.0"
ARK_ONCHAIN_OUTPUT_FEE="0.0"
